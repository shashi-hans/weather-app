# Copy to keystore.properties and fill in. That file is gitignored: never commit it,
# and keep the passwords in your password manager, not in the repo.
#
# Create the keystore first (it will prompt for the passwords):
#   keytool -genkeypair -v -keystore weather-sky-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias weather-sky
#
# Losing this file or its passwords means you can never update the app on Play
# under the same listing. Back it up somewhere safe.

storeFile=weather-sky-release.jks
storePassword=
keyAlias=weather-sky
keyPassword=
